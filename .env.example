# Copy to .env.local for local dev. Add the same keys in Vercel → Settings → Environment Variables
# (enable for Production and Preview).

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Workshop registration confirmation emails (Resend). Server-side only — no NEXT_PUBLIC prefix.
# RESEND_API_KEY: create at https://resend.com/api-keys
# WORKSHOP_FROM_EMAIL: a verified sender on your Resend-verified domain, e.g. no-reply@oysterschool.com
# WORKSHOP_ADMIN_EMAIL: inbox that gets notified of each new registration
RESEND_API_KEY=your-resend-api-key
WORKSHOP_FROM_EMAIL=Oyster School System <no-reply@yourdomain.com>
WORKSHOP_ADMIN_EMAIL=admin@yourdomain.com
